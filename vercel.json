{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tindry.com"
        }
      ],
      "destination": "https://www.tindry.com/:path*",
      "permanent": true
    },
    {
      "source": "/tools/mp4-to-mp3",
      "destination": "/mp4-to-mp3",
      "permanent": true
    },
    {
      "source": "/tools/webm-to-mp4",
      "destination": "/webm-to-mp4",
      "permanent": true
    },
    {
      "source": "/tools/convert/webm-to-mp4",
      "destination": "/webm-to-mp4",
      "permanent": true
    },
    {
      "source": "/tools/merge-pdf",
      "destination": "/merge-pdf",
      "permanent": true
    },
    {
      "source": "/tools/jpg-to-pdf",
      "destination": "/jpg-to-pdf",
      "permanent": true
    },
    {
      "source": "/tools/pdf-to-jpg",
      "destination": "/pdf-to-jpg",
      "permanent": true
    },
    {
      "source": "/tools/compress-image",
      "destination": "/compress-image",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/mp4-to-mp3",
      "destination": "/index.html"
    },
    {
      "source": "/webm-to-mp4",
      "destination": "/index.html"
    },
    {
      "source": "/merge-pdf",
      "destination": "/index.html"
    },
    {
      "source": "/jpg-to-pdf",
      "destination": "/index.html"
    },
    {
      "source": "/pdf-to-jpg",
      "destination": "/index.html"
    },
    {
      "source": "/compress-image",
      "destination": "/index.html"
    },
    {
      "source": "/screen-record",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/opengraph-image",
      "destination": "/opengraph-image.png"
    },
    {
      "source": "/((?!api/|assets/|favicon|robots\\.txt|sitemap\\.xml|og-image\\.svg|opengraph-image|record\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
